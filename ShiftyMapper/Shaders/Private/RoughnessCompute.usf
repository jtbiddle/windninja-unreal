// Terrain roughness calculation
// Supports standard deviation, range, and area ratio methods

#include "/Engine/Public/Platform.ush"

Texture2D<float> InputHeightmap;
RWTexture2D<float> OutputRoughness;

float2 TextureSize;
int WindowSize;
uint Method; // 0=StdDev, 1=Range, 2=AreaRatio

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void RoughnessCS(uint3 ThreadId : SV_DispatchThreadID)
{
	if (ThreadId.x >= (uint)TextureSize.x || ThreadId.y >= (uint)TextureSize.y)
		return;

	int2 coord = int2(ThreadId.xy);
	int halfWindow = WindowSize / 2;

	// Collect heights in window
	float heights[256]; // Max window size = 16 -> 256 samples
	int numSamples = 0;
	float sum = 0.0;
	float minHeight = 1e10;
	float maxHeight = -1e10;

	for (int dy = -halfWindow; dy <= halfWindow; dy++)
	{
		for (int dx = -halfWindow; dx <= halfWindow; dx++)
		{
			int2 sampleCoord = coord + int2(dx, dy);

			// Clamp to texture bounds
			sampleCoord = clamp(sampleCoord, int2(0, 0), int2(TextureSize) - int2(1, 1));

			float h = InputHeightmap.Load(int3(sampleCoord, 0));
			heights[numSamples] = h;
			sum += h;
			minHeight = min(minHeight, h);
			maxHeight = max(maxHeight, h);
			numSamples++;
		}
	}

	float roughness = 0.0;

	if (Method == 0) // Standard Deviation
	{
		float mean = sum / (float)numSamples;
		float variance = 0.0;

		for (int i = 0; i < numSamples; i++)
		{
			float diff = heights[i] - mean;
			variance += diff * diff;
		}

		variance /= (float)numSamples;
		roughness = sqrt(variance);
	}
	else if (Method == 1) // Range of Values
	{
		roughness = maxHeight - minHeight;
	}
	else if (Method == 2) // Area Ratio
	{
		// Calculate actual surface area vs. planar area
		float planarArea = (float)(WindowSize * WindowSize);
		float surfaceArea = 0.0;

		// Approximate surface area using triangulation
		for (int dy = 0; dy < WindowSize - 1; dy++)
		{
			for (int dx = 0; dx < WindowSize - 1; dx++)
			{
				int idx00 = dy * WindowSize + dx;
				int idx01 = dy * WindowSize + (dx + 1);
				int idx10 = (dy + 1) * WindowSize + dx;
				int idx11 = (dy + 1) * WindowSize + (dx + 1);

				// Two triangles per quad
				float3 v00 = float3(dx, dy, heights[idx00]);
				float3 v01 = float3(dx + 1, dy, heights[idx01]);
				float3 v10 = float3(dx, dy + 1, heights[idx10]);
				float3 v11 = float3(dx + 1, dy + 1, heights[idx11]);

				// Triangle 1
				float3 edge1 = v01 - v00;
				float3 edge2 = v10 - v00;
				surfaceArea += 0.5 * length(cross(edge1, edge2));

				// Triangle 2
				edge1 = v11 - v01;
				edge2 = v10 - v01;
				surfaceArea += 0.5 * length(cross(edge1, edge2));
			}
		}

		roughness = surfaceArea / planarArea - 1.0;
	}

	OutputRoughness[ThreadId.xy] = roughness;
}
