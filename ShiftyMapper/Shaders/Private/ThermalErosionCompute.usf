// Thermal Erosion using Talus Angle Method
// Material redistribution based on critical slope angle

#include "/Engine/Public/Platform.ush"

Texture2D<float> InputHeightmap;
RWTexture2D<float> OutputHeightmap;

float2 TextureSize;
float CellSize;
float TalusAngle;      // Critical angle in degrees (typically 30-45°)
float ThermalRate;     // Material movement rate (0-1)

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ThermalErosionCS(uint3 ThreadId : SV_DispatchThreadID)
{
    if (ThreadId.x >= (uint)TextureSize.x || ThreadId.y >= (uint)TextureSize.y)
        return;

    int2 coord = int2(ThreadId.xy);
    float centerHeight = InputHeightmap.Load(int3(coord, 0));

    // Talus tangent (tan of critical angle)
    float talusTangent = tan(radians(TalusAngle));

    // 8 neighbors
    int2 offsets[8] = {
        int2(-1, -1), int2(0, -1), int2(1, -1),
        int2(-1,  0),              int2(1,  0),
        int2(-1,  1), int2(0,  1), int2(1,  1)
    };

    float distances[8] = {
        1.414, 1.0, 1.414,
        1.0,        1.0,
        1.414, 1.0, 1.414
    };

    float totalMaterialMoved = 0.0;
    int numLowerNeighbors = 0;

    // First pass: Calculate total material to redistribute
    for (int i = 0; i < 8; i++)
    {
        int2 neighborCoord = coord + offsets[i];

        // Check bounds
        if (neighborCoord.x < 0 || neighborCoord.x >= TextureSize.x ||
            neighborCoord.y < 0 || neighborCoord.y >= TextureSize.y)
            continue;

        float neighborHeight = InputHeightmap.Load(int3(neighborCoord, 0));
        float heightDiff = centerHeight - neighborHeight;

        // Only consider downslope neighbors
        if (heightDiff > 0.0)
        {
            float distance = CellSize * distances[i];
            float slope = heightDiff / distance;

            // If slope exceeds talus angle, material should move
            if (slope > talusTangent)
            {
                float maxStableHeight = neighborHeight + distance * talusTangent;
                float excess = (centerHeight - maxStableHeight) * 0.5; // Share equally
                totalMaterialMoved += excess;
                numLowerNeighbors++;
            }
        }
    }

    // Apply thermal erosion rate
    totalMaterialMoved *= ThermalRate;

    // Update center height
    float newHeight = centerHeight - totalMaterialMoved;

    // Second pass would distribute to neighbors, but we do this implicitly
    // by lowering the center and letting neighbors rise in their own passes
    // This is a simplified version for GPU efficiency

    OutputHeightmap[coord] = newHeight;
}

// ============================================================================
// Multi-directional version (more accurate but requires multiple passes)
// ============================================================================

groupshared float sharedHeights[THREADGROUP_SIZE + 2][THREADGROUP_SIZE + 2];

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ThermalErosionMultiDirCS(uint3 ThreadId : SV_DispatchThreadID, uint3 GroupThreadId : SV_GroupThreadID)
{
    if (ThreadId.x >= (uint)TextureSize.x || ThreadId.y >= (uint)TextureSize.y)
        return;

    int2 coord = int2(ThreadId.xy);
    int2 localCoord = int2(GroupThreadId.xy) + int2(1, 1); // Offset for border

    // Load to shared memory with border
    sharedHeights[localCoord.y][localCoord.x] = InputHeightmap.Load(int3(coord, 0));

    // Load border pixels
    if (GroupThreadId.x == 0 && coord.x > 0)
        sharedHeights[localCoord.y][0] = InputHeightmap.Load(int3(coord + int2(-1, 0), 0));

    if (GroupThreadId.x == THREADGROUP_SIZE - 1 && coord.x < TextureSize.x - 1)
        sharedHeights[localCoord.y][THREADGROUP_SIZE + 1] = InputHeightmap.Load(int3(coord + int2(1, 0), 0));

    if (GroupThreadId.y == 0 && coord.y > 0)
        sharedHeights[0][localCoord.x] = InputHeightmap.Load(int3(coord + int2(0, -1), 0));

    if (GroupThreadId.y == THREADGROUP_SIZE - 1 && coord.y < TextureSize.y - 1)
        sharedHeights[THREADGROUP_SIZE + 1][localCoord.x] = InputHeightmap.Load(int3(coord + int2(0, 1), 0));

    GroupMemoryBarrierWithGroupSync();

    float centerHeight = sharedHeights[localCoord.y][localCoord.x];
    float talusTangent = tan(radians(TalusAngle));

    float materialToDistribute = 0.0;
    float weightSum = 0.0;

    // Calculate material to move and weights
    int2 localOffsets[8] = {
        int2(-1, -1), int2(0, -1), int2(1, -1),
        int2(-1,  0),              int2(1,  0),
        int2(-1,  1), int2(0,  1), int2(1,  1)
    };

    float distances[8] = {
        1.414, 1.0, 1.414,
        1.0,        1.0,
        1.414, 1.0, 1.414
    };

    float weights[8];

    for (int i = 0; i < 8; i++)
    {
        int2 neighborLocal = localCoord + localOffsets[i];
        float neighborHeight = sharedHeights[neighborLocal.y][neighborLocal.x];
        float heightDiff = centerHeight - neighborHeight;

        weights[i] = 0.0;

        if (heightDiff > 0.0)
        {
            float distance = CellSize * distances[i];
            float slope = heightDiff / distance;

            if (slope > talusTangent)
            {
                float excess = heightDiff - (distance * talusTangent);
                materialToDistribute += excess * 0.5;
                weights[i] = excess; // Weight by amount of excess
                weightSum += weights[i];
            }
        }
    }

    // Apply thermal rate
    materialToDistribute *= ThermalRate;

    // This cell loses material
    float newHeight = centerHeight - materialToDistribute;

    // Neighbors gain material (in a full implementation, this would be done
    // in a separate pass with atomic adds)

    OutputHeightmap[coord] = newHeight;
}
